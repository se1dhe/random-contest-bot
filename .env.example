# Пример файла переменных окружения
# Для локальной разработки можно использовать переменные окружения вместо config.ini
# Скопируйте этот файл в .env и заполните значения

# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_ID=your_admin_id_here
ADMIN_IDS=

# Database
DB_HOST=postgres
DB_PORT=5432
DB_NAME=contest_bot
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Web
WEB_PORT=8000
WEB_HOST=0.0.0.0
SECRET_KEY=your_secret_key_here
WEBAPP_URL=http://localhost:8000

# Subscriptions
SUBSCRIPTION_STARS_PRICE=299
SUBSCRIPTION_FIAT_CENTS=500
PAYKASSA_CHECKOUT_URL=
